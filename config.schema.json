{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/nxodh/deberopa/main/config.schema.json",
  "title": "Deberopa configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "theme": {
      "enum": [
        "mono",
        "ink",
        "paper"
      ]
    },
    "model": {
      "type": "string",
      "description": "Default model as provider/model"
    },
    "small_model": {
      "type": "string",
      "description": "Cheap model for titles, as provider/model"
    },
    "default_agent": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "autoupdate": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "notify"
        }
      ],
      "description": "false disables the daily update check; updates are never installed automatically"
    },
    "snapshot": {
      "type": "boolean",
      "description": "Record file snapshots for undo (git repositories only)"
    },
    "reasoning_effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "protocol": {
            "enum": [
              "anthropic",
              "openai",
              "ollama"
            ],
            "description": "Wire protocol. Defaults to openai (chat completions) except Anthropic; an Ollama endpoint defaults to ollama (its native API, which can set the context window)"
          },
          "api": {
            "type": "string",
            "description": "Base URL of the API, e.g. http://localhost:11434/v1"
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Environment variables that may hold the API key"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "apiKey": {
                "type": "string",
                "description": "Prefer {env:NAME} over writing a key here"
              },
              "baseURL": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeout": {
                "type": "number",
                "description": "Request timeout in milliseconds"
              },
              "max_concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64,
                "description": "At most this many model requests to this server at once; others wait their turn instead of earning 429 responses. Unset means unlimited, except that a Opereta gateway with a fixed slot count sets it to the slot count."
              },
              "ca": {
                "description": "PEM file path of the certificate authority this server's HTTPS certificate must chain to, or a list of paths (inline PEM text is also accepted). Relative paths are relative to the config file. The provider then trusts only these authorities, not the system store. A file that cannot be read makes the provider unusable; there is no fallback and no option to skip verification.",
                "anyOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                ]
              }
            }
          },
          "models": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Model id sent to the API when it differs from the key"
                },
                "name": {
                  "type": "string"
                },
                "limit": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "context": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    }
                  }
                },
                "cost": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "USD per million tokens",
                  "properties": {
                    "input": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    },
                    "cache_read": {
                      "type": "number"
                    },
                    "cache_write": {
                      "type": "number"
                    }
                  }
                },
                "reasoning": {
                  "type": "boolean"
                },
                "tool_call": {
                  "type": "boolean"
                },
                "attachment": {
                  "type": "boolean"
                },
                "temperature": {
                  "type": "boolean"
                },
                "options": {
                  "type": "object",
                  "description": "Extra request fields. Ollama: num_ctx, keep_alive, think, plus any sampling option. Any model: compact_prompt (true/false) forces or disables the short system prompt used for small context windows"
                }
              }
            }
          }
        }
      }
    },
    "disabled_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabled_providers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "When set, only these providers are used"
    },
    "agent": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "primary",
              "subagent",
              "all"
            ]
          },
          "model": {
            "type": "string",
            "description": "provider/model"
          },
          "prompt": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "steps": {
            "type": "number",
            "description": "Maximum agentic iterations before the agent must answer in text"
          },
          "tools": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "permission": {
            "anyOf": [
              {
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              },
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "enum": [
                          "allow",
                          "ask",
                          "deny"
                        ]
                      },
                      "description": "pattern -> action; later patterns win"
                    }
                  ]
                }
              }
            ],
            "description": "allow / ask / deny per permission key (edit, bash, read, webfetch, task, skill, external_directory, doom_loop, or an MCP tool id). A string applies to everything."
          },
          "disable": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "reasoning_effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template"
        ],
        "properties": {
          "template": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "subtask": {
            "type": "boolean"
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "command"
            ],
            "properties": {
              "type": {
                "const": "local"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "timeout": {
                "type": "number"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "url"
            ],
            "properties": {
              "type": {
                "const": "remote"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean"
              },
              "timeout": {
                "type": "number"
              }
            }
          }
        ]
      }
    },
    "permission": {
      "anyOf": [
        {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              },
              {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                "description": "pattern -> action; later patterns win"
              }
            ]
          }
        }
      ],
      "description": "allow / ask / deny per permission key (edit, bash, read, webfetch, task, skill, external_directory, doom_loop, or an MCP tool id). A string applies to everything."
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra instruction files: paths, globs or URLs"
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Turn tools off globally, e.g. {\"webfetch\": false}"
    },
    "formatter": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "disabled": {
                "type": "boolean"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "$FILE is replaced by the file path"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "lsp": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "disabled": {
                "type": "boolean"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "initialization": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "keybinds": {
      "type": "object",
      "additionalProperties": false,
      "description": "Prompt shortcuts. Comma-separated alternatives, ctrl/alt/shift modifiers; none disables an action. User config and trusted projects only.",
      "properties": {
        "interrupt": {
          "type": "string",
          "description": "Default: escape"
        },
        "clear_exit": {
          "type": "string",
          "description": "Default: ctrl+c"
        },
        "quit": {
          "type": "string",
          "description": "Default: ctrl+d"
        },
        "agent_next": {
          "type": "string",
          "description": "Default: tab"
        },
        "submit": {
          "type": "string",
          "description": "Default: enter"
        },
        "newline": {
          "type": "string",
          "description": "Default: shift+enter,alt+enter,ctrl+j"
        },
        "up": {
          "type": "string",
          "description": "Default: up"
        },
        "down": {
          "type": "string",
          "description": "Default: down"
        },
        "left": {
          "type": "string",
          "description": "Default: left,ctrl+b"
        },
        "right": {
          "type": "string",
          "description": "Default: right,ctrl+f"
        },
        "word_left": {
          "type": "string",
          "description": "Default: ctrl+left,alt+left,alt+b"
        },
        "word_right": {
          "type": "string",
          "description": "Default: ctrl+right,alt+right,alt+f"
        },
        "line_start": {
          "type": "string",
          "description": "Default: home,ctrl+a"
        },
        "line_end": {
          "type": "string",
          "description": "Default: end,ctrl+e"
        },
        "backspace": {
          "type": "string",
          "description": "Default: backspace"
        },
        "delete": {
          "type": "string",
          "description": "Default: delete"
        },
        "delete_word": {
          "type": "string",
          "description": "Default: ctrl+w,alt+backspace"
        },
        "delete_line_start": {
          "type": "string",
          "description": "Default: ctrl+u"
        },
        "delete_line_end": {
          "type": "string",
          "description": "Default: ctrl+k"
        },
        "models": {
          "type": "string",
          "description": "Default: none"
        },
        "sessions": {
          "type": "string",
          "description": "Default: none"
        },
        "new_session": {
          "type": "string",
          "description": "Default: none"
        },
        "help": {
          "type": "string",
          "description": "Default: none"
        },
        "editor": {
          "type": "string",
          "description": "Default: none"
        },
        "scroll_up": {
          "type": "string",
          "description": "Default: pageup"
        },
        "scroll_down": {
          "type": "string",
          "description": "Default: pagedown"
        },
        "scroll_top": {
          "type": "string",
          "description": "Default: ctrl+home"
        },
        "scroll_bottom": {
          "type": "string",
          "description": "Default: ctrl+end"
        }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "reserved": {
          "type": "number",
          "description": "Tokens kept free for the reply before compaction triggers"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "number"
        },
        "hostname": {
          "type": "string"
        }
      }
    },
    "local_detect": {
      "type": "boolean",
      "description": "false skips probing localhost for Ollama, LM Studio, llama.cpp and vLLM at startup"
    }
  }
}

{
  "name": "deberopa",
  "displayName": "Deberopa",
  "description": "Open the Deberopa AI coding agent beside your editor and send it the file or selection you are looking at.",
  "version": "0.2.0",
  "publisher": "nxodh",
  "license": "MIT",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/nxodh/deberopa.git", "directory": "ide/vscode" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "AI"],
  "keywords": ["ai", "agent", "coding", "terminal", "deberopa"],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "deberopa.open", "title": "Deberopa: Open" },
      { "command": "deberopa.addSelection", "title": "Deberopa: Add Selection to Prompt" },
      { "command": "deberopa.addFile", "title": "Deberopa: Add File to Prompt" }
    ],
    "keybindings": [
      { "command": "deberopa.open", "key": "ctrl+alt+v", "mac": "cmd+alt+v" },
      { "command": "deberopa.addSelection", "key": "ctrl+alt+k", "mac": "cmd+alt+k", "when": "editorTextFocus" }
    ],
    "menus": {
      "editor/context": [{ "command": "deberopa.addSelection", "group": "navigation@99", "when": "editorHasSelection" }],
      "explorer/context": [{ "command": "deberopa.addFile", "group": "navigation@99", "when": "!explorerResourceIsFolder" }]
    },
    "configuration": {
      "title": "Deberopa",
      "properties": {
        "deberopa.command": {
          "type": "string",
          "default": "deberopa",
          "description": "The command that starts Deberopa. Use a full path if it is not on your PATH."
        },
        "deberopa.arguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra arguments, for example [\"-m\", \"anthropic/claude-sonnet-5-5\"]."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js",
    "package": "npm run build && vsce package --no-dependencies --out deberopa.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}

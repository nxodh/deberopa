{
  "name": "vedecaps",
  "displayName": "Vedecaps",
  "description": "Open the Vedecaps AI coding agent beside your editor and send it the file or selection you are looking at.",
  "version": "0.1.2",
  "publisher": "nxodh",
  "license": "MIT",
  "icon": "icon.png",
  "repository": { "type": "git", "url": "https://github.com/nxodh/vedecaps.git", "directory": "ide/vscode" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "AI"],
  "keywords": ["ai", "agent", "coding", "terminal", "vedecaps"],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "vedecaps.open", "title": "Vedecaps: Open" },
      { "command": "vedecaps.addSelection", "title": "Vedecaps: Add Selection to Prompt" },
      { "command": "vedecaps.addFile", "title": "Vedecaps: Add File to Prompt" }
    ],
    "keybindings": [
      { "command": "vedecaps.open", "key": "ctrl+alt+v", "mac": "cmd+alt+v" },
      { "command": "vedecaps.addSelection", "key": "ctrl+alt+k", "mac": "cmd+alt+k", "when": "editorTextFocus" }
    ],
    "menus": {
      "editor/context": [{ "command": "vedecaps.addSelection", "group": "navigation@99", "when": "editorHasSelection" }],
      "explorer/context": [{ "command": "vedecaps.addFile", "group": "navigation@99", "when": "!explorerResourceIsFolder" }]
    },
    "configuration": {
      "title": "Vedecaps",
      "properties": {
        "vedecaps.command": {
          "type": "string",
          "default": "vedecaps",
          "description": "The command that starts Vedecaps. Use a full path if it is not on your PATH."
        },
        "vedecaps.arguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra arguments, for example [\"-m\", \"anthropic/claude-sonnet-5-5\"]."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js",
    "package": "npm run build && vsce package --no-dependencies --out vedecaps.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
